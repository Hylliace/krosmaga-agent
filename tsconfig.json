{
  "compilerOptions": {
    "target": "es2023",
    // DOM is here for the browser-side surface only: the AI web worker
    // (`self`, `Worker`, `MessageEvent`) and the WASM kernels (`WebAssembly`).
    // The engine itself touches no browser API.
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["node"],
    "skipLibCheck": true,

    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.ts"]
}
